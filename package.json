{
  "name": "ltw_notes_desktop",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "npm run build && node --test tests/e2e/*.test.cjs",
    "test:database": "node --test tests/database.test.cjs tests/data-transfer.test.cjs",
    "type-check": "vue-tsc -b",
    "build": "vue-tsc -b && vite build",
    "desktop:pack:mac": "npm run build && electron-builder --mac dir --arm64",
    "desktop:build:mac": "npm run build && electron-builder --mac dmg --arm64",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/view": "^6.43.6",
    "@iconify/vue": "^5.0.1",
    "@milkdown/crepe": "^7.21.3",
    "@milkdown/kit": "^7.21.3",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^13.0.1",
    "dompurify": "^3.4.12",
    "marked": "^18.0.7",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vue-tsc": "^3.3.5",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "cn.lovethewind.notes.offline",
    "productName": "心悦笔记",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "protocols": [
      {
        "name": "心悦笔记浏览器登录",
        "schemes": [
          "xinyue-notes"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "心悦笔记 ${version}",
      "iconSize": 100,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
